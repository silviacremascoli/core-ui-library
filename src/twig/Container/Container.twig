{# Container Component - Twig Template #}
<div class="
  cui-container
  cui-container--{{ size|default('large') }}
  {% if align is defined and align != '' and align != 'center' %}cui-container--align-{{ align }}{% endif %}
  {% if noPadding %}cui-container--no-padding{% endif %}
  {% if fluid %}cui-container--fluid{% endif %}
  {% if className is defined %} {{ className|raw }}{% endif %}">
  {{ content|raw }}
</div>