{
  "name": "@silviacremascoli/core-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/core-ui.es.js",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "prepare": "npm run build",
    "build": "vite build && vue-tsc -p tsconfig.build.json && node scripts/prepare-declarations.mjs",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.4.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/html-vite": "^10.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "playwright": "^1.62.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.1",
    "typescript": "~5.9.3",
    "vite": "^8.3.3",
    "vite-plugin-twig-drupal": "^1.6.2",
    "vitest": "^4.1.10",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.14"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-brands-svg-icons": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "twig": "^3.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/core-ui.es.js"
    },
    "./react": {
      "types": "./dist/types/react/index.d.ts",
      "import": "./dist/react/index.es.js"
    },
    "./vue": {
      "types": "./dist/types/vue/index.d.ts",
      "import": "./dist/vue/index.es.js"
    },
    "./twig": {
      "types": "./dist/types/twig/index.d.ts",
      "import": "./dist/twig/index.es.js"
    },
    "./styles": {
      "types": "./dist/types/styles.d.ts",
      "default": "./dist/core-ui.css"
    }
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vue": "^3.0.0"
  }
}
